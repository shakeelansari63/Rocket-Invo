{
  "name": "rocket-invo",
  "version": "1.0.0",
  "description": "Rocket Invo - Small Business Billing & Invoicing",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run build:electron && ./node_modules/.bin/concurrently -n server,electron \"npx vite\" \"npx wait-on http://localhost:5173 && ./node_modules/.bin/electron . --dev\"",
    "electron:dev:quick": "./run-dev.sh",
    "electron:build": "npm run build:electron && vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "sql.js": "^1.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "antd": "^5.24.6",
    "@ant-design/icons": "^5.6.1",
    "dayjs": "^1.11.13",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^33.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.rocketinvo.app",
    "productName": "Rocket Invo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "logo.png",
        "to": "logo.png"
      },
      {
        "from": "logo.ico",
        "to": "logo.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "logo.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "logo.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "logo.png"
    }
  }
}
